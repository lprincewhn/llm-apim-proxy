<policies>
  <inbound>
    <base />
    <rate-limit-by-key calls="30" renewal-period="60" counter-key="@(&quot;svhwb107-&quot; + context.Subscription.Id)" />
    <set-variable name="route" value="{{chat-route}}" />
    <choose>
      <when condition="@(context.Operation.Id != &quot;native-embedding&quot; &amp;&amp; !((JArray)JObject.Parse((string)context.Variables[&quot;route&quot;])[&quot;enabled&quot;]).Any(item =&gt; (string)item == (string)JObject.Parse((string)context.Variables[&quot;route&quot;])[&quot;primary&quot;]))">
        <return-response>
          <set-status code="503" reason="No healthy backends" />
        </return-response>
      </when>
    </choose>
    <set-variable name="selected" value="@{if (context.Operation.Id == &quot;native-embedding&quot;) { return &quot;embedding&quot;; } return (string)JObject.Parse((string)context.Variables[&quot;route&quot;])[&quot;primary&quot;]; }" />
    <choose>
      <when condition="@((string)context.Variables[&quot;selected&quot;] == &quot;eastus2&quot;)">
        <set-backend-service backend-id="llm-eastus2" />
        <rewrite-uri template="/openai/deployments/gpt-5.1/chat/completions" copy-unmatched-params="true" />
      </when>
      <when condition="@((string)context.Variables[&quot;selected&quot;] == &quot;sweden&quot;)">
        <set-backend-service backend-id="llm-sweden" />
        <rewrite-uri template="/openai/deployments/svhwb107-gpt51/chat/completions" copy-unmatched-params="true" />
      </when>
      <when condition="@((string)context.Variables[&quot;selected&quot;] == &quot;embedding&quot;)">
        <set-backend-service backend-id="llm-embedding" />
        <rewrite-uri template="/openai/deployments/text-embedding-3-small/embeddings" copy-unmatched-params="true" />
      </when>
      <otherwise>
        <return-response>
          <set-status code="503" reason="Unknown route backend" />
        </return-response>
      </otherwise>
    </choose>
    <set-query-parameter name="subscription-key" exists-action="delete" />
    <set-header name="Ocp-Apim-Subscription-Key" exists-action="delete" />
    <set-header name="Authorization" exists-action="delete" />
    <set-header name="api-key" exists-action="delete" />
    <set-header name="X-Executor-Key" exists-action="delete" />
    <set-header name="X-Budget-Ms" exists-action="delete" />
    <set-header name="X-Idle-Ms" exists-action="delete" />
    <set-header name="X-Remaining-Budget-Ms" exists-action="delete" />
    <authentication-managed-identity resource="https://cognitiveservices.azure.com" client-id="3dfb189c-3492-4eb9-80f8-4bc97213bf76" ignore-error="false" />
  </inbound>
  <backend>
    <forward-request timeout="120" buffer-request-body="false" buffer-response="false" fail-on-error-status-code="false" />
  </backend>
  <outbound>
    <base />
    <set-header name="X-Lab-Attempts" exists-action="override">
      <value>1</value>
    </set-header>
    <set-header name="X-Lab-Backend" exists-action="override">
      <value>@((string)context.Variables["selected"])</value>
    </set-header>
    <set-header name="X-Lab-Request-Id" exists-action="override">
      <value>@(context.RequestId.ToString())</value>
    </set-header>
  </outbound>
  <on-error>
    <base />
    <set-header name="X-Lab-Error-Reason" exists-action="override">
      <value>@(context.LastError.Reason)</value>
    </set-header>
    <set-header name="X-Lab-Error-Source" exists-action="override">
      <value>@(context.LastError.Source)</value>
    </set-header>
    <set-header name="X-Lab-Error-Path" exists-action="override">
      <value>@(context.LastError.Path)</value>
    </set-header>
    <set-header name="X-Lab-Error-Detail" exists-action="override">
      <value>@(context.LastError.Source == "forward-request" ? context.LastError.Message : "")</value>
    </set-header>
  </on-error>
</policies>
