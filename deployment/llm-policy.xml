onse="true" fail-on-error-status-code="false" /></retry></backend><outbound><base /><set-header name="X-Lab-Attempts" exists-action="override"><value>@(((int)context.Variables["attempt"]).ToString())</value></set-header><set-header name="X-Lab-Backend" exists-action="override"><value>@((string)context.Variables["selected"])</value></set-header><set-header name="X-Lab-Request-Id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header></outbound><on-error><base /><set-header name="X-Lab-Error-Reason" exists-action="override"><value>@(context.LastError.Reason)</value></set-header><set-header name="X-Lab-Error-Source" exists-action="override"><value>@(context.LastError.Source)</value></set-header><set-header name="X-Lab-Error-Path" exists-action="override"><value>@(context.LastError.Path)</value></set-header><set-header name="X-Lab-Error-Detail" exists-action="override"><value>@(context.LastError.Source == "forward-request" ? context.LastError.Message : "")</value></set-header></on-error></policies>