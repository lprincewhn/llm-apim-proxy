<policies><inbound><base /><rate-limit-by-key calls="30" renewal-period="60" counter-key="@(&quot;svhwb107-&quot; + context.Subscription.Id)" /><set-variable name="purpose" value="@(context.Operation.Id)" /><choose><when condition="@{ var body = context.Request.Body.As&lt;JObject&gt;(preserveContent: true); var model = (string)body[&quot;model&quot;]; var expected = context.Operation.Id == &quot;embedding&quot; ? &quot;text-embedding-3-small&quot; : &quot;gpt-5.1&quot;; return model != null &amp;&amp; model != expected; }"><return-response><set-status code="400" reason="Unsupported model" /></return-response></when></choose><set-body>@{ var body = context.Request.Body.As&lt;JObject&gt;(); body.Remove("model"); return body.ToString(); }</set-body><set-variable name="budget" value="@((string)context.Variables[&quot;purpose&quot;] == &quot;rewrite&quot; ? 1200 : (string)context.Variables[&quot;purpose&quot;] == &quot;embedding&quot; ? 500 : (string)context.Variables[&quot;purpose&quot;] == &quot;intent&quot; ? 5000 : 4000)" /><set-variable name="budget" value="@{ int remaining; var raw = context.Request.Headers.GetValueOrDefault(&quot;X-Remaining-Budget-Ms&quot;, &quot;&quot;); if (int.TryParse(raw, out remaining)) { return Math.Max(1, Math.Min(remaining, (int)context.Variables[&quot;budget&quot;])); } return (int)context.Variables[&quot;budget&quot;]; }" /><set-variable name="route" value="{{chat-route}}" /><set-variable name="attempt" value="@(0)" /><choose><when condition="@((string)context.Variables[&quot;purpose&quot;] != &quot;embedding&quot; &amp;&amp; ((JArray)JObject.Parse((string)context.Variables[&quot;route&quot;])[&quot;enabled&quot;]).Count == 0)"><return-response><set-status code="503" reason="No healthy backends" /></return-response></when></choose></inbound><backend><retry condition="@(context.Response != null &amp;&amp; (context.Response.StatusCode == 429 || context.Response.StatusCode &gt;= 500) &amp;&amp; (string)context.Variables[&quot;purpose&quot