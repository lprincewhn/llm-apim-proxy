<policies>
  <inbound>
    <base />
    <rate-limit-by-key calls="30" renewal-period="60" counter-key="@(&quot;svhwb107-&quot; + context.Subscription.Id)" />
    <set-variable name="purpose" value="@(context.Operation.Id)" />
    <choose>
      <when condition="@{ var body = context.Request.Body.As&lt;JObject&gt;(preserveContent: true); var model = (string)body[&quot;model&quot;]; var expected = context.Operation.Id == &quot;embedding&quot; ? &quot;text-embedding-3-small&quot; : &quot;gpt-5.1&quot;; return (model != null &amp;&amp; model != expected) || (body[&quot;stream&quot;] != null &amp;&amp; body[&quot;stream&quot;].Type != JTokenType.Null &amp;&amp; (body[&quot;stream&quot;].Type != JTokenType.Boolean || (bool)body[&quot;stream&quot;])); }">
        <return-response>
          <set-status code="400" reason="Unsupported model or streaming" />
        </return-response>
      </when>
    </choose>
    <set-body>@{ var body = context.Request.Body.As&lt;JObject&gt;(); body.Remove("model"); return body.ToString(); }</set-body>
    <set-variable name="budget" value="@((string)context.Variables[&quot;purpose&quot;] == &quot;rewrite&quot; ? 1200 : (string)context.Variables[&quot;purpose&quot;] == &quot;embedding&quot; ? 500 : (string)context.Variables[&quot;purpose&quot;] == &quot;intent&quot; ? 5000 : 4000)" />
    <set-variable name="budget" value="@{ int remaining; var raw = context.Request.Headers.GetValueOrDefault(&quot;X-Remaining-Budget-Ms&quot;, &quot;&quot;); if (int.TryParse(raw, out remaining)) { return Math.Max(1, Math.Min(remaining, (int)context.Variables[&quot;budget&quot;])); } return (int)context.Variables[&quot;budget&quot;]; }" />
    <set-variable name="route" value="{{chat-route}}" />
    <choose>
      <when condition="@((string)context.Variables[&quot;purpose&quot;] != &quot;embedding&quot; &amp;&amp; ((JArray)JObject.Parse((string)context.Variables[&quot;route&quot;])[&quot;enabled&quot;]).Count == 0)">
        <return-response>
          <set-status code="503" reason="No healthy backends" />
        </return-response>
      </when>
    </choose>
    <set-variable name="selected" value="@{if ((string)context.Variables[&quot;purpose&quot;] == &quot;embedding&quot;) { return &quot;embedding&quot;; } return (string)JObject.Parse((string)context.Variables[&quot;route&quot;])[&quot;primary&quot;]; }" />
    <choose>
      <when condition="@((string)context.Variables[&quot;selected&quot;] == &quot;eastus2&quot;)">
        <set-backend-service backend-id="llm-eastus2" />
        <rewrite-uri template="/openai/deployments/gpt-5.1/chat/completions" copy-unmatched-params="false" />
      </when>
      <when condition="@((string)context.Variables[&quot;selected&quot;] == &quot;sweden&quot;)">
        <set-backend-service backend-id="llm-sweden" />
        <rewrite-uri template="/openai/deployments/svhwb107-gpt51/chat/completions" copy-unmatched-params="false" />
      </when>
      <when condition="@((string)context.Variables[&quot;selected&quot;] == &quot;embedding&quot;)">
        <set-backend-service backend-id="llm-embedding" />
        <rewrite-uri template="/openai/deployments/text-embedding-3-small/embeddings" copy-unmatched-params="false" />
      </when>
      <otherwise>
        <return-response>
          <set-status code="503" reason="Unknown route backend" />
        </return-response>
      </otherwise>
    </choose>
    <set-query-parameter name="api-version" exists-action="override">
      <value>2024-10-21</value>
    </set-query-parameter>
    <set-header name="Ocp-Apim-Subscription-Key" exists-action="delete" />
    <set-header name="Authorization" exists-action="delete" />
    <set-header name="api-key" exists-action="delete" />
    <set-header name="X-Executor-Key" exists-action="delete" />
    <set-header name="X-Budget-Ms" exists-action="delete" />
    <set-header name="X-Idle-Ms" exists-action="delete" />
    <set-header name="X-Remaining-Budget-Ms" exists-action="delete" />
    <authentication-managed-identity resource="https://cognitiveservices.azure.com" client-id="3dfb189c-3492-4eb9-80f8-4bc97213bf76" ignore-error="false" />
  </inbound>
  <backend>
    <forward-request timeout="@(Math.Max(1, (int)Math.Ceiling(((int)context.Variables[&quot;budget&quot;] - (DateTime.UtcNow - context.Timestamp).TotalMilliseconds) / 1000.0)))" buffer-request-body="true" buffer-response="true" fail-on-error-status-code="false" />
  </backend>
  <outbound>
    <base />
    <set-header name="X-Lab-Attempts" exists-action="override">
      <value>1</value>
    </set-header>
    <set-header name="X-Lab-Backend" exists-action="override">
      <value>@((string)context.Variables["selected"])</value>
    </set-header>
    <set-header name="X-Lab-Request-Id" exists-action="override">
      <value>@(context.RequestId.ToString())</value>
    </set-header>
  </outbound>
  <on-error>
    <base />
    <set-header name="X-Lab-Error-Reason" exists-action="override">
      <value>@(context.LastError.Reason)</value>
    </set-header>
    <set-header name="X-Lab-Error-Source" exists-action="override">
      <value>@(context.LastError.Source)</value>
    </set-header>
    <set-header name="X-Lab-Error-Path" exists-action="override">
      <value>@(context.LastError.Path)</value>
    </set-header>
    <set-header name="X-Lab-Error-Detail" exists-action="override">
      <value>@(context.LastError.Source == "forward-request" ? context.LastError.Message : "")</value>
    </set-header>
  </on-error>
</policies>
